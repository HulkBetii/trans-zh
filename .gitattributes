# Normalize text files, but pin line endings where they are load-bearing.
* text=auto

# Shell scripts MUST stay LF: a CRLF shebang fails on Linux/macOS with
# "bad interpreter: /usr/bin/env bash^M".
*.sh    text eol=lf

# PowerShell is Windows-side; keep CRLF.
*.ps1   text eol=crlf

# Binary assets must never be line-ending converted.
*.png   binary
*.ttf   binary
*.otf   binary
*.mp4   binary
*.m4a   binary
*.wav   binary
