# Copy sang `zhsub.toml` rồi sửa. API key đọc từ biến môi trường, KHÔNG để trong file này.
# Giai đoạn benchmark (bench/) không dùng phần [llm.*] — chỉ cần khi chạy S2 trở đi.

[paths]
work_dir = "work"
cache_dir = ".cache"
jobs_db = "jobs.db"

# ---------------------------------------------------------------------------
# S0 — ingest
# ---------------------------------------------------------------------------
[ingest]
sample_rate = 16000
channels = 1
# Bilibili / URL: yt-dlp lấy cookie từ browser đang đăng nhập.
# Để "" nếu chỉ tải video công khai. Giá trị hợp lệ: chrome, edge, firefox, brave...
cookies_from_browser = "edge"

# ---------------------------------------------------------------------------
# S1 — ASR. Timestamp sinh ra ở đây là nguồn sự thật duy nhất cho toàn pipeline.
# ---------------------------------------------------------------------------
[asr]
engine = "funasr-paraformer"
model = "paraformer-zh"
vad_model = "fsmn-vad"
punc_model = "ct-punc"
device = "auto"          # auto | cuda | cpu
batch_size_s = 300       # cửa sổ gộp VAD của FunASR (giây)

# FunASR đã tự cắt theo VAD và trả timestamp tuyệt đối. Lớp chunk bên ngoài chỉ
# bật khi file dài hơn ngưỡng này — bọc thêm một tầng offset là tự chuốc bug.
outer_chunk_threshold_sec = 5400   # 90 phút
outer_chunk_sec = 1800             # 30 phút
outer_chunk_overlap_sec = 8.0

# ---------------------------------------------------------------------------
# S2 — ngắt câu lại theo ngữ nghĩa
# ---------------------------------------------------------------------------
[segment]
min_duration_sec = 0.8
max_duration_sec = 7.0
merge_gap_sec = 0.25
# Chuỗi gửi cho LLM được chia nhỏ tại khoảng lặng VAD dài hơn ngưỡng này.
chunk_at_silence_sec = 0.5
max_chars_per_llm_call = 1800
# Dưới ngưỡng khớp này thì coi như LLM trả về sai chuỗi, không repair nữa.
repair_min_ratio = 0.95
max_retries = 2

# ---------------------------------------------------------------------------
# S4 — dịch
# ---------------------------------------------------------------------------
[translate]
batch_size = 40
context_before = 10
context_after = 5
review_pass = true       # lượt 2: tự rà và chỉnh lại
max_retries = 3          # hết retry thì chia đôi batch
prompt_version = 1       # BẮT BUỘC bump khi sửa prompt, nếu không sẽ ăn cache cũ

# ---------------------------------------------------------------------------
# S5 — render. Giới hạn tách theo ngôn ngữ: 42 ký tự / CPS 21 là chuẩn chữ
# Latin, quá rộng cho dòng tiếng Trung (chuẩn CJK ~20 ký tự / CPS 9).
# ---------------------------------------------------------------------------
[render]
max_lines = 2

[render.limits.vi]
max_chars_per_line = 42
max_cps = 21.0

[render.limits.en]
max_chars_per_line = 42
max_cps = 21.0

[render.limits.zh]
max_chars_per_line = 20
max_cps = 9.0

# ---------------------------------------------------------------------------
# LLM. Model dùng để ngắt câu và model dùng để dịch cấu hình riêng: S2 là việc
# cơ học (chèn dấu ngắt) nên dùng model rẻ, S4 mới cần model mạnh.
#
# provider: "openai" (mọi endpoint OpenAI-compatible) | "anthropic" | "chatgpt_web"
# api_key_env: tên BIẾN MÔI TRƯỜNG chứa key, không phải key.
#              Để "" nếu endpoint chạy local và không cần xác thực.
# ---------------------------------------------------------------------------
[llm.segment]
provider = "openai"
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
model = "SET_ME"          # ví dụ một model nhỏ, rẻ
temperature = 0.0
max_retries = 3
timeout_sec = 120

[llm.translate]
provider = "openai"
base_url = "https://api.openai.com/v1"
api_key_env = "OPENAI_API_KEY"
model = "SET_ME"          # model mạnh nhất bạn có quyền dùng
temperature = 0.3
max_retries = 3
timeout_sec = 180

# --- Chạy hoàn toàn local bằng Ollama (không tốn tiền API) -----------------
# Cài: winget install Ollama.Ollama
# Kho model nên đặt ngoài ổ hệ thống: đặt biến môi trường OLLAMA_MODELS,
# ví dụ D:\ollama-models — model 7B chiếm khoảng 5GB.
# Tải model: ollama pull qwen2.5:7b-instruct
#
# [llm.translate]
# provider = "openai"
# base_url = "http://localhost:11434/v1"
# api_key_env = ""              # Ollama không cần key
# model = "qwen2.5:7b-instruct"
# temperature = 0.3
# timeout_sec = 600             # model local chậm hơn API nhiều
#
# Model local nhỏ hay phá vỡ ràng buộc tập id ở S4. Nếu thấy log báo chia đôi
# batch liên tục thì giảm translate.batch_size xuống 10-15.

# ---------------------------------------------------------------------------
# S6 — lồng tiếng. Chạy riêng bằng `zhsub dub <job_id>`, KHÔNG nằm trong `run`
# vì mỗi cue là một lần gọi API trả tiền (video 17 phút hết 184 lần).
# Đặt API key qua biến môi trường AI33_API_KEY.
# ---------------------------------------------------------------------------
# [dub]
# voice_id = "SET_ME"       # xem GET /v3/voices?provider=vbee
# base_speed = 1.0          # tốc độ đọc mọi cue
# max_speed = 1.0           # bằng base_speed = không bao giờ tăng tốc
# min_gap_sec = 0.25        # nhịp thở tối thiểu giữa hai câu
# concurrency = 4           # đừng nâng: 8 làm backend trả server_busy liên tục
#
# Hai hằng số dưới là SỐ ĐO của riêng voice_id ở trên. Đổi giọng thì chạy
# `zhsub dub-calibrate <job_id>` để đo lại — dùng số của giọng khác thì S6 tính
# sai tốc độ mà không báo lỗi gì.
# overhead_sec = 0.15
# sec_per_syllable = 0.217

# --- Anthropic cho khâu dịch (cần đặt ANTHROPIC_API_KEY) -------------------
# [llm.translate]
# provider = "anthropic"
# base_url = "https://api.anthropic.com"
# api_key_env = "ANTHROPIC_API_KEY"
# model = "SET_ME"
# temperature = 0.3

# --- ChatGPT web qua Playwright (không tốn tiền API) -----------------------
# Lái thẳng giao diện chatgpt.com bằng trình duyệt đã đăng nhập. Không cần API
# key, đổi lại: selector hỏng bất cứ lúc nào OpenAI đổi UI, chậm hơn API nhiều,
# và tự động hoá web UI là trái ToS của OpenAI.
#
# Cài: uv sync --extra chatgpt-web && playwright install chromium
# Đăng nhập một lần: zhsub chatgpt-login
#
# Chi phí tính bằng SỐ LẦN GỌI chứ không phải token — mỗi lần ~10-15s phí cố định.
# Bật provider này thì nên tăng translate.batch_size (60). review_pass gấp đôi số
# lần gọi S4 — đo được là đáng: sửa 7% số câu, và sửa nghĩa chứ không nống chữ.
# Mọi lần gọi nối đuôi nhau qua một cửa sổ trình duyệt, nên `batch -j N` không làm
# phần LLM nhanh hơn. Chạm hạn mức tin nhắn thì job dừng ngay, resume được.
#
# [llm.segment]
# provider = "chatgpt_web"
# model = "chatgpt-web"     # chỉ là nhãn cho khoá cache, không phải model thật
# max_retries = 2
# timeout_sec = 300
#
# [llm.translate]
# provider = "chatgpt_web"
# model = "chatgpt-web"
# temperature = 0.3
# max_retries = 3
# timeout_sec = 900         # UI chậm hơn API nhiều; batch 60 câu dễ vượt 300s
#
# [llm.chatgpt_web]
# profile_dir = "data/chrome_profile"
# account_file = "data/chatgpt_account.json"   # không có file cũng chạy được
# manual_login_timeout_sec = 300
#
# account_file (tuỳ chọn) — chỉ tạo nếu muốn tự đăng nhập lại khi hết phiên.
# Mật khẩu nằm plaintext trên đĩa, nên cách khuyến nghị là bỏ hẳn file này và
# đăng nhập tay một lần bằng `zhsub chatgpt-login`.
#   {
#     "email": "...",
#     "password": "...",
#     "totp_secret": "..."      // chỉ khi tài khoản bật MFA
#   }
